amends "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v1.57.0/hk@1.57.0#/Builtins.pkl"

// Two steps, both of which CI runs again. This is here so the round trip is a second rather than a
// pull request, not so it can be the only place the check happens.
local linters = new Mapping<String, Step> {
  ["cargo_fmt"] = Builtins.cargo_fmt
  ["cargo_clippy"] = Builtins.cargo_clippy
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = linters
  }
  ["fix"] {
    fix = true
    steps = linters
  }
  ["check"] {
    steps = linters
  }
}
